# Second Brain — Git configuration

# Keep owner-specific memories and raw captures out of the application baseline.
brain/

# Obsidian cache and workspace state (regenerates automatically)
brain/.obsidian/workspace.json
brain/.obsidian/cache

# Rebuildable indexes and inter-process coordination state
brain/.chroma/
brain/.chroma.previous-*/
brain/.sidecar/

# Virtual environments
.venv/

# Agent scratch space — never commit in-progress work
brain/1-desk/*.draft
brain/1-desk/*.link-pending
brain/1-desk/refinery-handoff-*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor temp files
*.swp
*.tmp
*~

# Python/runtime output
__pycache__/
*.py[cod]
*.log

# Local agent scratch
.agents/

# Reproducible page previews rendered while preparing the learning-design memo.
# Their source PDFs and SHA-256 inventory are recorded in docs/learning-and-memory-design-synthesis.md.
tmp/
tmp/pdfs/

# Node dependencies and desktop/extension/mobile build artifacts
node_modules/
desktop/node_modules/
mobile/vault-client/node_modules/
mobile/vault-client/android/.gradle/
mobile/vault-client/android/build/
mobile/vault-client/android/app/build/
mobile/vault-client/android/local.properties
mobile/vault-client/ios/App/Pods/
mobile/vault-client/ios/DerivedData/
dist/
desktop/dist/
release-artifacts/
merged-dist/
*.whl
*.exe
*.msi
*.dmg
*.AppImage
*.deb
*.vsix
*.pfx
*.p12
*.pem
*.key
*.cer
*.sbvault
.env
.env.*
pypi-dist/
