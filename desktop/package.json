{
  "name": "second-brain-desktop",
  "version": "1.0.0",
  "description": "Second Brain — Local-first verifiable AI memory desktop app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis",
    "dist:win": "electron-builder --win nsis msi",
    "dist:msi": "electron-builder --win msi",
    "dist:mac": "electron-builder --mac dmg zip",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist:all": "electron-builder -mwl"
  },
  "author": "Second Brain",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.secondbrain.desktop",
    "productName": "Second Brain",
    "publish": [
      {
        "provider": "github",
        "owner": "prodofthecentury",
        "repo": "second-brain"
      }
    ],
    "afterPack": "./build/afterPack.js",
    "afterSign": "./build/notarize.js",
    "afterAllArtifactBuild": "./build/afterAllArtifactBuild.js",
    "toolsets": {
      "winCodeSign": "1.1.0"
    },
    "directories": {
      "output": "../dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "../second_brain",
        "to": "backend/second_brain",
        "filter": [
          "**/*.py"
        ]
      },
      {
        "from": "../scripts",
        "to": "backend/scripts",
        "filter": [
          "**/*.py",
          "!**/*_tests.py",
          "!test_all.py",
          "!smoke_test.py",
          "!run_desktop_tests.py",
          "!run_vscode_tests.py",
          "!**/*_canary.py"
        ]
      },
      {
        "from": "../pyproject.toml",
        "to": "backend/pyproject.toml"
      },
      {
        "from": "../uv.lock",
        "to": "backend/uv.lock"
      },
      {
        "from": "../README.md",
        "to": "backend/README.md"
      },
      {
        "from": "../dashboard",
        "to": "backend/dashboard",
        "filter": [
          "**/*.py"
        ]
      },
      {
        "from": "../.streamlit/config.toml",
        "to": "backend/.streamlit/config.toml"
      },
      {
        "from": "../plugins",
        "to": "backend/plugins",
        "filter": [
          "**/*",
          "!**/mcp_config.json",
          "!**/*.bak*",
          "!**/.env*",
          "!**/*.key",
          "!**/*.pem",
          "!**/*.pfx",
          "!**/*.p12"
        ]
      },
      {
        "from": "../mobile",
        "to": "backend/mobile",
        "filter": [
          "**/*",
          "!**/node_modules/**",
          "!**/test/**",
          "!**/tests/**",
          "!**/androidTest/**",
          "!**/fastlane/**",
          "!**/package-lock.json",
          "!**/.gradle/**",
          "!**/android/build/**",
          "!**/android/app/build/**",
          "!**/android/local.properties",
          "!**/gradle-wrapper.jar",
          "!**/android/app/src/main/assets/public/**",
          "!**/ios/Pods/**",
          "!**/ios/DerivedData/**",
          "!**/ios/App/App/public/**",
          "!**/*.jks",
          "!**/*.keystore",
          "!**/*.p12",
          "!**/*.pfx",
          "!**/*.p8",
          "!**/*.pem",
          "!**/*.key",
          "!**/*.sbvault",
          "!**/.env*",
          "!**/google-services.json",
          "!**/play-key.json"
        ]
      },
      {
        "from": "../setup.ps1",
        "to": "backend/setup.ps1"
      },
      {
        "from": "../setup.sh",
        "to": "backend/setup.sh"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Second-Brain-Setup-${version}-${arch}.${ext}",
      "signtoolOptions": {
        "sign": "./build/sign.js",
        "signingHashAlgorithms": [
          "sha256"
        ]
      }
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Second Brain"
    },
    "msi": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Second Brain",
      "warningsAsErrors": false,
      "additionalLightArgs": [
        "-sval"
      ]
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "Second-Brain-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "Second Brain ${version}"
    },
    "linux": {
      "category": "Utility",
      "icon": "assets/icon.png",
      "maintainer": "Second Brain",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Second-Brain-${version}-${arch}.${ext}"
    }
  }
}
