{
  "name": "second-brain-vscode",
  "displayName": "Second Brain — Local AI Memory",
  "description": "Zero-friction notes, SHA-256 verified atoms, Merkle inclusion proofs, contradiction radar, instant recall, and streaming chat inside VS Code, Cursor, and Windsurf.",
  "version": "1.0.0",
  "publisher": "second-brain",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/second-brain/second-brain.git",
    "directory": "extensions/vscode-second-brain"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "AI"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onFileSystem:secondbrain-note"
  ],
  "main": "./extension.js",
  "scripts": {
    "test": "node --test test/"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "restrictedConfigurations": [
        "secondBrain.apiPort",
        "secondBrain.ownerTokenPath"
      ]
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "second-brain-container",
          "title": "Second Brain",
          "icon": "$(book)"
        }
      ]
    },
    "views": {
      "second-brain-container": [
        {
          "id": "secondBrain.vaultView",
          "name": "Vault Explorer"
        }
      ]
    },
    "commands": [
      {
        "command": "secondBrain.rememberSelection",
        "title": "Second Brain: Remember Selection"
      },
      {
        "command": "secondBrain.quickRecall",
        "title": "Second Brain: Quick Recall"
      },
      {
        "command": "secondBrain.openChat",
        "title": "Second Brain: Open Streaming Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "secondBrain.createNote",
        "title": "Second Brain: Create Working Note",
        "icon": "$(new-file)"
      },
      {
        "command": "secondBrain.editNote",
        "title": "Second Brain: Edit Working Note",
        "icon": "$(edit)"
      },
      {
        "command": "secondBrain.deleteNote",
        "title": "Second Brain: Delete Working Note",
        "icon": "$(trash)"
      },
      {
        "command": "secondBrain.verifyNoteExcerpt",
        "title": "Second Brain: Verify Note Excerpt as Atom",
        "icon": "$(verified)"
      },
      {
        "command": "secondBrain.promoteInboxItem",
        "title": "Second Brain: Promote Quarantined Inbox Item",
        "icon": "$(check)"
      },
      {
        "command": "secondBrain.rejectInboxItem",
        "title": "Second Brain: Reject Quarantined Inbox Item",
        "icon": "$(close)"
      },
      {
        "command": "secondBrain.approveAtom",
        "title": "Second Brain: Approve Pending Atom",
        "icon": "$(pass)"
      },
      {
        "command": "secondBrain.rejectAtom",
        "title": "Second Brain: Reject Atom",
        "icon": "$(error)"
      },
      {
        "command": "secondBrain.demoteAtom",
        "title": "Second Brain: Demote Verified Atom",
        "icon": "$(arrow-down)"
      },
      {
        "command": "secondBrain.quarantineAtom",
        "title": "Second Brain: Quarantine Atom",
        "icon": "$(shield)"
      },
      {
        "command": "secondBrain.mergeAtoms",
        "title": "Second Brain: Merge Duplicate Atoms",
        "icon": "$(git-merge)"
      },
      {
        "command": "secondBrain.promotePlaybook",
        "title": "Second Brain: Promote Skill Playbook",
        "icon": "$(rocket)"
      },
      {
        "command": "secondBrain.deprecatePlaybook",
        "title": "Second Brain: Deprecate Skill Playbook",
        "icon": "$(archive)"
      },
      {
        "command": "secondBrain.assemblePlan",
        "title": "Second Brain: Assemble Executive Plan"
      },
      {
        "command": "secondBrain.verifyLedger",
        "title": "Second Brain: Verify Vault Merkle Ledger"
      },
      {
        "command": "secondBrain.commitLedger",
        "title": "Second Brain: Commit Vault Merkle Ledger Checkpoint"
      },
      {
        "command": "secondBrain.proveAtom",
        "title": "Second Brain: Prove Verified Atom or Playbook Membership"
      },
      {
        "command": "secondBrain.scanContradictions",
        "title": "Second Brain: Scan Contradiction & Drift Radar"
      },
      {
        "command": "secondBrain.scanContradictionsNli",
        "title": "Second Brain: Scan Contradictions with Local NLI (nli=1)"
      },
      {
        "command": "secondBrain.showTasks",
        "title": "Second Brain: Show Action Items & Tasks",
        "icon": "$(tasklist)"
      },
      {
        "command": "secondBrain.syncVault",
        "title": "Second Brain: Encrypted E2EE Vault Sync (Status / Push / Pull / Verify)",
        "icon": "$(sync)"
      },
      {
        "command": "secondBrain.createSnapshot",
        "title": "Second Brain: Create Vault Snapshot"
      },
      {
        "command": "secondBrain.diffSnapshot",
        "title": "Second Brain: Diff Snapshot vs Live Vault"
      },
      {
        "command": "secondBrain.recallSnapshot",
        "title": "Second Brain: Recall at Historical Snapshot"
      },
      {
        "command": "secondBrain.verifySnapshot",
        "title": "Second Brain: Verify Snapshot Integrity"
      },
      {
        "command": "secondBrain.recordExperience",
        "title": "Second Brain: Record Episodic Experience"
      },
      {
        "command": "secondBrain.switchVault",
        "title": "Second Brain: Switch Vault Workspace"
      },
      {
        "command": "secondBrain.federatedSearch",
        "title": "Second Brain: Federated Cross-Vault Search"
      },
      {
        "command": "secondBrain.pairClipper",
        "title": "Second Brain: Pair Browser Web Clipper (1-Click Code or Origin)"
      },
      {
        "command": "secondBrain.newChatThread",
        "title": "Second Brain: New Multi-Turn Chat Thread"
      },
      {
        "command": "secondBrain.pinChatTurn",
        "title": "Second Brain: Pin Last Chat Answer to Working Note"
      },
      {
        "command": "secondBrain.autoLinkGraph",
        "title": "Second Brain: Auto-Link Knowledge Graph Atoms"
      },
      {
        "command": "secondBrain.resolveSyncConflicts",
        "title": "Second Brain: Resolve E2EE Sync Conflicts (3-Way)"
      },
      {
        "command": "secondBrain.manageOnnxModels",
        "title": "Second Brain: Manage Local ONNX Models (Status / Pull / Verify)"
      },
      {
        "command": "secondBrain.setAtomValidity",
        "title": "Second Brain: Set Atom Bi-Temporal Validity (valid_from / valid_until)"
      },
      {
        "command": "secondBrain.mobileInboxDrop",
        "title": "Second Brain: Mobile E2EE Inbox Drop (Pair PWA / Pull Drops / Revoke)"
      },
      {
        "command": "secondBrain.ingestMedia",
        "title": "Second Brain: Ingest Media (Audio / Screenshot / Document)"
      },
      {
        "command": "secondBrain.installGitHook",
        "title": "Second Brain: Install Git Post-Commit Hook"
      },
      {
        "command": "secondBrain.uninstallGitHook",
        "title": "Second Brain: Uninstall Git Post-Commit Hook"
      },
      {
        "command": "secondBrain.distillGitCommits",
        "title": "Second Brain: Distill Recent Git Commits to Memory"
      },
      {
        "command": "secondBrain.backupVault",
        "title": "Second Brain: Portable Vault Backup & Restore (.sbvault)"
      },
      {
        "command": "secondBrain.refreshVault",
        "title": "Second Brain: Refresh Vault",
        "icon": "$(refresh)"
      },
      {
        "command": "secondBrain.openTreeItem",
        "title": "Second Brain: Open Vault Item"
      },
      {
        "command": "secondBrain.loadMoreSection",
        "title": "Second Brain: Load More Vault Items"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "secondBrain.rememberSelection",
          "when": "editorHasSelection",
          "group": "navigation@1"
        },
        {
          "command": "secondBrain.verifyNoteExcerpt",
          "when": "editorHasSelection",
          "group": "navigation@2"
        }
      ],
      "view/title": [
        {
          "command": "secondBrain.createNote",
          "when": "view == secondBrain.vaultView",
          "group": "navigation@1"
        },
        {
          "command": "secondBrain.openChat",
          "when": "view == secondBrain.vaultView",
          "group": "navigation@2"
        },
        {
          "command": "secondBrain.refreshVault",
          "when": "view == secondBrain.vaultView",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "secondBrain.editNote",
          "when": "view == secondBrain.vaultView && viewItem == secondBrain.note",
          "group": "inline@1"
        },
        {
          "command": "secondBrain.deleteNote",
          "when": "view == secondBrain.vaultView && viewItem == secondBrain.note",
          "group": "inline@2"
        },
        {
          "command": "secondBrain.verifyNoteExcerpt",
          "when": "view == secondBrain.vaultView && viewItem == secondBrain.note",
          "group": "1_governance@1"
        },
        {
          "command": "secondBrain.promoteInboxItem",
          "when": "view == secondBrain.vaultView && viewItem == secondBrain.inboxItem",
          "group": "inline@1"
        },
        {
          "command": "secondBrain.rejectInboxItem",
          "when": "view == secondBrain.vaultView && viewItem == secondBrain.inboxItem",
          "group": "inline@2"
        },
        {
          "command": "secondBrain.approveAtom",
          "when": "view == secondBrain.vaultView && viewItem == secondBrain.pendingAtom",
          "group": "inline@1"
        },
        {
          "command": "secondBrain.rejectAtom",
          "when": "view == secondBrain.vaultView && viewItem == secondBrain.pendingAtom",
          "group": "inline@2"
        },
        {
          "command": "secondBrain.quarantineAtom",
          "when": "view == secondBrain.vaultView && viewItem == secondBrain.pendingAtom",
          "group": "1_governance@1"
        },
        {
          "command": "secondBrain.mergeAtoms",
          "when": "view == secondBrain.vaultView && viewItem == secondBrain.pendingAtom",
          "group": "1_governance@2"
        },
        {
          "command": "secondBrain.setAtomValidity",
          "when": "view == secondBrain.vaultView && viewItem == secondBrain.pendingAtom",
          "group": "1_governance@3"
        },
        {
          "command": "secondBrain.proveAtom",
          "when": "view == secondBrain.vaultView && viewItem == secondBrain.verifiedAtom",
          "group": "1_governance@1"
        },
        {
          "command": "secondBrain.demoteAtom",
          "when": "view == secondBrain.vaultView && viewItem == secondBrain.verifiedAtom",
          "group": "1_governance@2"
        },
        {
          "command": "secondBrain.quarantineAtom",
          "when": "view == secondBrain.vaultView && viewItem == secondBrain.verifiedAtom",
          "group": "1_governance@3"
        },
        {
          "command": "secondBrain.mergeAtoms",
          "when": "view == secondBrain.vaultView && viewItem == secondBrain.verifiedAtom",
          "group": "1_governance@4"
        },
        {
          "command": "secondBrain.setAtomValidity",
          "when": "view == secondBrain.vaultView && viewItem == secondBrain.verifiedAtom",
          "group": "1_governance@5"
        },
        {
          "command": "secondBrain.proveAtom",
          "when": "view == secondBrain.vaultView && viewItem == secondBrain.playbook",
          "group": "1_governance@1"
        },
        {
          "command": "secondBrain.deprecatePlaybook",
          "when": "view == secondBrain.vaultView && viewItem == secondBrain.playbook",
          "group": "1_governance@2"
        },
        {
          "command": "secondBrain.diffSnapshot",
          "when": "view == secondBrain.vaultView && viewItem == secondBrain.snapshot",
          "group": "1_governance@1"
        },
        {
          "command": "secondBrain.recallSnapshot",
          "when": "view == secondBrain.vaultView && viewItem == secondBrain.snapshot",
          "group": "1_governance@2"
        },
        {
          "command": "secondBrain.verifySnapshot",
          "when": "view == secondBrain.vaultView && viewItem == secondBrain.snapshot",
          "group": "1_governance@3"
        }
      ],
      "commandPalette": [
        {
          "command": "secondBrain.openTreeItem",
          "when": "false"
        },
        {
          "command": "secondBrain.loadMoreSection",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "secondBrain.rememberSelection",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "editorHasSelection"
      },
      {
        "command": "secondBrain.quickRecall",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r"
      }
    ],
    "configuration": {
      "title": "Second Brain",
      "properties": {
        "secondBrain.apiPort": {
          "type": "number",
          "default": 8765,
          "scope": "application",
          "description": "Explicit loopback port override for the local Second Brain HTTP API (user/application scope only; ignored in workspace settings). When unset, auto-discovers live port from SecondBrain/security/api-port and falls back to 8765."
        },
        "secondBrain.ownerTokenPath": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Optional explicit path to the local Second Brain owner token file (user/application scope only)."
        }
      }
    }
  }
}
