{
  "name": "second-brain-vscode",
  "displayName": "Second Brain — Local AI Memory",
  "description": "Zero-friction notes, SHA-256 verified atoms, Merkle inclusion proofs, contradiction radar, instant recall, and streaming chat inside VS Code, Cursor, and Windsurf.",
  "version": "0.2.0",
  "publisher": "second-brain",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "AI"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "restrictedConfigurations": [
        "secondBrain.apiPort",
        "secondBrain.ownerTokenPath"
      ]
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "second-brain-container",
          "title": "Second Brain",
          "icon": "$(book)"
        }
      ]
    },
    "views": {
      "second-brain-container": [
        {
          "id": "secondBrain.vaultView",
          "name": "Vault Explorer"
        }
      ]
    },
    "commands": [
      {
        "command": "secondBrain.rememberSelection",
        "title": "Second Brain: Remember Selection"
      },
      {
        "command": "secondBrain.quickRecall",
        "title": "Second Brain: Quick Recall"
      },
      {
        "command": "secondBrain.openChat",
        "title": "Second Brain: Open Streaming Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "secondBrain.assemblePlan",
        "title": "Second Brain: Assemble Executive Plan"
      },
      {
        "command": "secondBrain.verifyLedger",
        "title": "Second Brain: Verify Vault Merkle Ledger"
      },
      {
        "command": "secondBrain.proveAtom",
        "title": "Second Brain: Prove Verified Atom Membership"
      },
      {
        "command": "secondBrain.scanContradictions",
        "title": "Second Brain: Scan Contradiction & Drift Radar"
      },
      {
        "command": "secondBrain.createSnapshot",
        "title": "Second Brain: Create Vault Snapshot"
      },
      {
        "command": "secondBrain.diffSnapshot",
        "title": "Second Brain: Diff Snapshot vs Live Vault"
      },
      {
        "command": "secondBrain.recordExperience",
        "title": "Second Brain: Record Episodic Experience"
      },
      {
        "command": "secondBrain.refreshVault",
        "title": "Second Brain: Refresh Vault",
        "icon": "$(refresh)"
      },
      {
        "command": "secondBrain.openTreeItem",
        "title": "Second Brain: Open Vault Item"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "secondBrain.rememberSelection",
          "when": "editorHasSelection",
          "group": "navigation@1"
        }
      ],
      "view/title": [
        {
          "command": "secondBrain.openChat",
          "when": "view == secondBrain.vaultView",
          "group": "navigation@1"
        },
        {
          "command": "secondBrain.refreshVault",
          "when": "view == secondBrain.vaultView",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "secondBrain.openTreeItem",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "secondBrain.rememberSelection",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "editorHasSelection"
      },
      {
        "command": "secondBrain.quickRecall",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r"
      }
    ],
    "configuration": {
      "title": "Second Brain",
      "properties": {
        "secondBrain.apiPort": {
          "type": "number",
          "default": 8765,
          "scope": "application",
          "description": "Loopback TCP port for the Second Brain Memory API (0 or default auto-discovers live Desktop/CLI port from SecondBrain/security/api-port, falling back to 8765; user/application scope only)."
        },
        "secondBrain.ownerTokenPath": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Optional explicit path to the local Second Brain owner token file (user/application scope only)."
        }
      }
    }
  }
}
